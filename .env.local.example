# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings → API).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — used exclusively by scripts/seed-prompts.ts. Never expose
# this to the browser (no NEXT_PUBLIC_ prefix) and never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — Sentry error tracking (instrumentation.ts, instrumentation-client.ts).
# Leave these unset locally/in CI; the SDK is explicitly disabled with no
# DSN (no network calls, no console warnings).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Only needed to upload source maps during `next build` (a release step,
# not runtime) — leave unset locally.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
