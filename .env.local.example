# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings → API).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — used exclusively by scripts/seed-prompts.ts. Never expose
# this to the browser (no NEXT_PUBLIC_ prefix) and never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — overrides lib/site.ts's canonical origin (metadataBase,
# sitemap.xml, robots.txt). Only needed if the production domain ever
# changes; lib/site.ts already defaults to atlas.ordinarydev.in in
# production and localhost:3000 in dev, so this doesn't need to be set
# for a normal deploy.
# NEXT_PUBLIC_SITE_URL=https://atlas.ordinarydev.in
