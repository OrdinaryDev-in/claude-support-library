{
  "name": "claude-prompt-library",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "node --env-file=.env.local --import tsx scripts/seed-prompts.ts",
    "seed:skills": "node --env-file=.env.local --import tsx scripts/seed-skills.ts",
    "generate-seed-sql": "npx tsx scripts/generate-seed-sql.ts",
    "supabase:security-check": "bash scripts/check-supabase-security.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "bash scripts/write-e2e-env.sh && NODE_ENV=test playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.8.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/env": "16.3.1",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "husky": "^9.1.7",
    "supabase": "2.114.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
